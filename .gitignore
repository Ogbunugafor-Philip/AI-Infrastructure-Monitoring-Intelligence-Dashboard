*.so
.Python
develop-eggs/
downloads/
eggs/
.eggs/
sdist/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
# NOTE: Python setuptools build dirs (build/, dist/, lib/, lib64/, parts/, var/)
# are intentionally NOT globally ignored here — they would clash with the
# Next.js frontend source dir `frontend/lib/`. The Python venv (and its lib/)
# is already excluded via the `venv/` rule below. Scope build artifacts to the
# backend instead:
backend/build/
backend/dist/

# Python virtual environments
venv/
env/
ENV/
.venv/
virtualenv/
*.pyenv

